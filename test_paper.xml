<mujoco>
    <compiler angle="degree"/>
    <option gravity="0 0 -9.81"/>
    
    <worldbody>
        <!-- Basic lighting -->
        <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>

        <!-- The Table with Legs -->
        <body name="table" pos="0 0 0">
            <!-- Table Top -->
            <geom type="box" size="0.15 0.15 0.01" pos="0 0 0.2" rgba="0.4 0.2 0.1 1" friction="1 0.005 0.0001"/>
            
            <!-- Table Legs -->
            <geom type="box" size="0.01 0.01 0.1" pos="0.13 0.13 0.1" rgba="0.3 0.15 0.05 1"/>
            <geom type="box" size="0.01 0.01 0.1" pos="-0.13 0.13 0.1" rgba="0.3 0.15 0.05 1"/>
            <geom type="box" size="0.01 0.01 0.1" pos="0.13 -0.13 0.1" rgba="0.3 0.15 0.05 1"/>
            <geom type="box" size="0.01 0.01 0.1" pos="-0.13 -0.13 0.1" rgba="0.3 0.15 0.05 1"/>
        </body>

        <!-- The 4-Fold Paper Object (W-Shape) -->
        <body name="folded_paper" pos="0 0 0.25">
            <freejoint/> 
            <!-- 4 Ultra-thin panels -->
            <geom type="box" size="0.0141 0.0002 0.05" pos="-0.03 0.01 0" euler="0 0 -45" rgba="0.9 0.9 0.9 1" mass="0.002"/>
            <geom type="box" size="0.0141 0.0002 0.05" pos="-0.01 0.01 0" euler="0 0 45" rgba="0.9 0.9 0.9 1" mass="0.002"/>
            <geom type="box" size="0.0141 0.0002 0.05" pos="0.01 0.01 0" euler="0 0 -45" rgba="0.9 0.9 0.9 1" mass="0.002"/>
            <geom type="box" size="0.0141 0.0002 0.05" pos="0.03 0.01 0" euler="0 0 45" rgba="0.9 0.9 0.9 1" mass="0.002"/>
            
            <!-- 3 Hinge Cylinders to fill the corners -->
            <geom type="cylinder" size="0.0002 0.05" pos="-0.02 0 0" rgba="0.9 0.9 0.9 1" mass="0.0001"/>
            <geom type="cylinder" size="0.0002 0.05" pos="0 0.02 0" rgba="0.9 0.9 0.9 1" mass="0.0001"/>
            <geom type="cylinder" size="0.0002 0.05" pos="0.02 0 0" rgba="0.9 0.9 0.9 1" mass="0.0001"/>
        </body>
    </worldbody>
</mujoco>